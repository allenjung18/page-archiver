{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "fixtures/**/*.ts",
    "test/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "*.config.ts"
  ]
}
